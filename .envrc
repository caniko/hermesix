strict_env

watch_file flake.nix flake.lock Cargo.toml Cargo.lock
watch_dir nix
nix_direnv_disallow_fallback
use flake "git+file://$PWD" --no-update-lock-file || return 1
if test -f ../nix-opencode-lsp/flake.nix; then
  watch_file ../nix-opencode-lsp/lib/default.nix ../nix-opencode-lsp/flake.nix ../nix-opencode-lsp/flake.lock
  hermesix_lsp_root="$(cd -P ../nix-opencode-lsp && pwd -P)"
  direnv_layout_dir="$(direnv_layout_dir)/opencode-lsp" use flake 'git+https://github.com/caniko/harbor.git?ref=feat/harbor-monorepo-components&rev=e8b1996580e4ecd51dd402edf4a16d9df88e3a1b#rust-opencode-lsp' --override-input nix-opencode-lsp "git+file://$hermesix_lsp_root" --no-write-lock-file || return 1
  unset hermesix_lsp_root
fi
